<?xml version="1.0" encoding="utf-8"?>
<!-- Battery bar for the widget: a thin capsule, tinted in code (champagne, green while charging, orange when low). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape><corners android:radius="2dp" /><solid android:color="#FF2C2C2E" /></shape>
    </item>
    <item android:id="@android:id/progress">
        <clip><shape><corners android:radius="2dp" /><solid android:color="#FFD6B98A" /></shape></clip>
    </item>
</layer-list>
